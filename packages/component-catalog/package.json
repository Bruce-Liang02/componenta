{
  "name": "@componenta/component-catalog",
  "version": "0.1.0",
  "description": "Componenta 组件 UI 变体选型目录",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./data": {
      "import": "./dist/data/index.js",
      "types": "./dist/data/index.d.ts"
    },
    "./pages": {
      "import": "./dist/pages/index.js",
      "types": "./dist/pages/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "validate": "tsx scripts/validate-catalog.ts",
    "build-catalog": "tsx scripts/build-catalog.ts"
  },
  "dependencies": {
    "@componenta/core": "workspace:*",
    "@componenta/components": "workspace:*",
    "antd": "^5.0.0",
    "@ant-design/icons": "^5.0.0",
    "react": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "js-yaml": "^4.1.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
