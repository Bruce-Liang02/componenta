{
  "name": "@componenta/web-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Componenta 管理后台应用",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "build:check": "tsc --noEmit",
    "preview": "vite preview --port 5173",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
